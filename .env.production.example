APP_NAME=HIMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=https://patientaccess.djnrmhs.com
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=REMOTE_ADDR
SANCTUM_STATEFUL_DOMAINS=patientaccess.djnrmhs.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=db.example.internal
DB_PORT=3306
DB_DATABASE=pacc_production
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_BACKUP_ENABLED=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=coor_

INACTIVITY_ENABLED=true
INACTIVITY_TIMEOUT=900

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="admin@patientaccess.djnrmhs.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=pacc-private
AWS_ENDPOINT=https://objects.example.com
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Replace REMOTE_ADDR above with HostForge's exact trusted proxy CIDRs after
# confirming them. Verify HTTPS redirect behavior before serving traffic.

# ---------------------------------------------------------------------------
# HIMS External Integrations
# ---------------------------------------------------------------------------
# These are OPTIONAL. Core HIMS works without them.
# When disabled, the app clearly shows "Not Configured" / development mode.
# ---------------------------------------------------------------------------

GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

ZOOM_ENABLED=false
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

ZAPIER_ENABLED=false
ZAPIER_WEBHOOK_URL=
