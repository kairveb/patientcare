# REQUIRED — application identity/security. Generate APP_KEY once with Artisan and retain it across releases.
APP_NAME=HIMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://patientaccess.djnrmhs.com
# REQUIRED — hospital timezone.
APP_TIMEZONE=Asia/Manila
# OPTIONAL — application language defaults.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# OPTIONAL — framework maintenance mode configuration.
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
APP_PREVIOUS_KEYS=

# OPTIONAL — exact browser frontend origin(s); leave blank for same-origin requests.
CORS_ALLOWED_ORIGINS=
# REQUIRED behind a proxy — ask HostForge for the exact source addresses/CIDRs seen by the container.
# Trust only those addresses; do not use "*" or guess Cloudflare/HostForge ranges.
TRUSTED_PROXIES=REPLACE_WITH_PROVIDER_PROXY_CIDRS
# OPTIONAL — opt in on a single instance during a serialized deployment; otherwise run migrate --force as a release task.
RUN_MIGRATIONS=false
# OPTIONAL — hostnames for first-party Sanctum cookie-authenticated API requests.
SANCTUM_STATEFUL_DOMAINS=patientaccess.djnrmhs.com

# REQUIRED — copy endpoint/database/user values from the hosting database panel; use a least-privilege app account.
DB_CONNECTION=mariadb
DB_HOST=database.example.test
DB_PORT=3306
DB_DATABASE=hims_production
DB_USERNAME=hims_app
DB_PASSWORD=REPLACE_WITH_DATABASE_SECRET
# OPTIONAL — MySQL URL/socket and encoding overrides; normally use the fields above.
DB_URL=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# OPTIONAL — provider TLS CA path when required.
MYSQL_ATTR_SSL_CA=

# REQUIRED — database-backed sessions; enable HTTPS-only encrypted cookies in production.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_STORE=
SESSION_COOKIE=
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
# INITIAL BOOTSTRAP ONLY — supply through HostForge secrets; remove the password after app:bootstrap-admin succeeds.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# RECOMMENDED — inactivity policy.
SESSION_IDLE_MINUTES=5
INACTIVITY_ENABLED=true
# RECOMMENDED — OTP/login limits; tune only to an approved policy.
OTP_ENABLED=true
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
OTP_MAX_SENDS=5
OTP_RESEND_COOLDOWN_SECONDS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=2

# REQUIRED for queued reminders — database queue requires a running worker.
QUEUE_CONNECTION=database
# OPTIONAL — database queue table, queue name, retry timeout, and failed-job store overrides.
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids
# RECOMMENDED — database cache is shared across processes.
CACHE_STORE=database
CACHE_PREFIX=hims_production_
# OPTIONAL — database cache table/connection overrides.
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=
# REQUIRED for this single-container image — Reverb is not started in the container.
BROADCAST_CONNECTION=null

# REQUIRED when OTP/email is enabled — obtain SMTP values and an authorized sender from your email provider.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.test
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_SECRET
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME="${APP_NAME}"
# OPTIONAL — only for the selected mail provider.
MAIL_URL=
MAIL_EHLO_DOMAIN=
MAIL_ENCRYPTION=
MAIL_SENDMAIL_PATH=
MAIL_LOG_CHANNEL=
POSTMARK_API_KEY=
RESEND_API_KEY=

# REQUIRED on ephemeral hosts — S3 provides durable private uploads; local storage needs a mounted persistent volume.
FILESYSTEM_DISK=s3
# OPTIONAL — obtain an S3-compatible bucket and credentials from the object-storage provider.
AWS_ACCESS_KEY_ID=REPLACE_WITH_OBJECT_STORAGE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_OBJECT_STORAGE_SECRET
AWS_DEFAULT_REGION=auto
AWS_BUCKET=hims-private
AWS_ENDPOINT=https://objects.example.test
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# RECOMMENDED — host-managed logs; disable local database dumps when provider backups are configured.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
DB_BACKUP_ENABLED=false

# OPTIONAL — rules is the default; obtain keys from Google AI Studio/OpenAI only if selecting that provider.
AI_PROVIDER=rules
AI_TIMEOUT=10
AI_RETRIES=1
AI_SEND_AGE_SEX=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OPTIONAL — get Zoom credentials from Zoom Marketplace; jitsi_demo is demo-only, never for real consultations.
TELEHEALTH_PROVIDER=
TELEHEALTH_JOIN_EARLY_MINUTES=15
TELEHEALTH_JOIN_LATE_MINUTES=30
ZOOM_ENABLED=false
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# RECOMMENDED — approved values from the person responsible for privacy/legal review.
DPO_NAME=REPLACE_WITH_PRIVACY_CONTACT_NAME
DPO_EMAIL=privacy@example.test
DPO_PHONE=+00-000-0000
PRIVACY_NOTICE_VERSION=1.0
TERMS_VERSION=1.0
PRIVACY_EFFECTIVE_DATE=2026-11-03
REPORT_PASSWORD_CONFIRM_MINUTES=5

# OPTIONAL — approved appointment workflow settings.
APPOINTMENT_REASSIGNMENT_WINDOW_DAYS=7
APPOINTMENT_FULLY_BOOKED_WINDOW_DAYS=7
APPOINTMENT_REQUIRES_APPROVAL=true
