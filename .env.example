# Local template. Replace placeholders privately; never commit populated credentials.
# REQUIRED — application identity/security; generate APP_KEY with Artisan; other values are yours.
APP_NAME=HIMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# RECOMMENDED — set the hospital's timezone; Asia/Manila for this project.
APP_TIMEZONE=Asia/Manila
# OPTIONAL — application language defaults.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# OPTIONAL — framework maintenance mode configuration.
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
APP_PREVIOUS_KEYS=

# OPTIONAL — configure exact frontend origin only when using cross-origin requests.
CORS_ALLOWED_ORIGINS=
# REQUIRED behind a proxy — obtain exact proxy addresses/CIDRs from the hosting provider.
TRUSTED_PROXIES=REMOTE_ADDR
# OPTIONAL — hostnames for first-party Sanctum cookie-authenticated API requests.
SANCTUM_STATEFUL_DOMAINS=

# REQUIRED — obtain connection details and a least-privilege user from the database host.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hims_local
DB_USERNAME=hims_app
DB_PASSWORD=
# OPTIONAL — MySQL URL/socket and encoding overrides; normally use the fields above.
DB_URL=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# OPTIONAL — database provider TLS CA path, if required by the provider.
MYSQL_ATTR_SSL_CA=

# RECOMMENDED — persistent database-backed session on deployed environments.
SESSION_DRIVER=database
SESSION_LIFETIME=20
SESSION_ENCRYPT=false
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_STORE=
SESSION_COOKIE=
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
# RECOMMENDED — inactivity behavior; this is the timeout setting read by the app.
SESSION_IDLE_MINUTES=20
INACTIVITY_ENABLED=true
# RECOMMENDED — OTP/login limits; tune only to an approved policy.
OTP_ENABLED=true
OTP_TTL_MINUTES=2
OTP_LOCKOUT_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
OTP_MAX_SENDS=5
OTP_RESEND_COOLDOWN_SECONDS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=2

# REQUIRED for queued reminders — database queue requires migrations and a running worker.
QUEUE_CONNECTION=database
# OPTIONAL — database queue table, queue name, retry timeout, and failed-job store overrides.
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids
# RECOMMENDED — database cache is shared across app processes.
CACHE_STORE=database
CACHE_PREFIX=hims_local_
# OPTIONAL — database cache table/connection overrides.
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=
# RECOMMENDED — use null unless a separately hosted Reverb service is configured.
BROADCAST_CONNECTION=null

# REQUIRED when OTP/email is enabled — obtain SMTP values and an authorized sender from your email provider.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"
# OPTIONAL — only for the selected mail provider.
MAIL_URL=
MAIL_EHLO_DOMAIN=
MAIL_ENCRYPTION=
MAIL_SENDMAIL_PATH=
MAIL_LOG_CHANNEL=
POSTMARK_API_KEY=
RESEND_API_KEY=

# REQUIRED on ephemeral hosts — use s3 for durable uploaded documents; local is for local development.
FILESYSTEM_DISK=local
# OPTIONAL — S3-compatible credentials/config from the object-storage provider when FILESYSTEM_DISK=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# RECOMMENDED — send logs to the host's log collector in deployed environments.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
# RECOMMENDED — disable local mysqldump scheduling when using managed database backups.
DB_BACKUP_ENABLED=false

# OPTIONAL — rules is the local/default decision-support provider; provider credentials come from Google AI Studio/OpenAI.
AI_PROVIDER=rules
AI_TIMEOUT=10
AI_RETRIES=1
AI_SEND_AGE_SEX=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OPTIONAL — Zoom credentials from Zoom Marketplace; telehealth provider may be zoom or explicitly demo-only jitsi_demo.
TELEHEALTH_PROVIDER=
TELEHEALTH_JOIN_EARLY_MINUTES=15
TELEHEALTH_JOIN_LATE_MINUTES=30
ZOOM_ENABLED=false
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# RECOMMENDED — obtain approved contact information and notice versions from the person responsible for privacy/legal review.
DPO_NAME=
DPO_EMAIL=
DPO_PHONE=
PRIVACY_NOTICE_VERSION=1.0
CONFIDENTIALITY_NOTICE_VERSION=1.0
TERMS_VERSION=1.0
PRIVACY_EFFECTIVE_DATE=2026-11-03
REPORT_PASSWORD_CONFIRM_MINUTES=5

# OPTIONAL — appointment behavior from the approved operating workflow.
APPOINTMENT_REASSIGNMENT_WINDOW_DAYS=7
APPOINTMENT_FULLY_BOOKED_WINDOW_DAYS=7
APPOINTMENT_REQUIRES_APPROVAL=true
