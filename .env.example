APP_NAME=HIMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://coor.test
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=REMOTE_ADDR

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coor
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_IDLE_MINUTES=5
OTP_ENABLED=true
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
OTP_MAX_SENDS=5
OTP_RESEND_COOLDOWN_SECONDS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=2

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=hims-local
REVERB_APP_KEY=hims-local-key
REVERB_APP_SECRET=hims-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Development-only example. Configure a real production mail transport before enabling OTP in production.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# HIMS External Integrations
# ---------------------------------------------------------------------------
# These are OPTIONAL. Core HIMS works without them.
# When disabled, the app clearly shows "Not Configured" / development mode.
# ---------------------------------------------------------------------------

# Google Maps (address autocomplete, hospital location)
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

# Server-side AI triage provider: rules, gemini, or openai
AI_PROVIDER=rules
AI_TIMEOUT=10
AI_RETRIES=1

# Google Gemini (assistive triage only; never a clinical decision)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (assistive triage only; never a clinical decision)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Zoom (telehealth meetings)
ZOOM_ENABLED=false
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Leave unset to require configured Zoom. Set jitsi_demo only for an explicitly opted-in demo; never for real consultations.
TELEHEALTH_PROVIDER=
TELEHEALTH_JOIN_EARLY_MINUTES=15
TELEHEALTH_JOIN_LATE_MINUTES=30

# Appointment behavior (defaults shown; configure to match approved hospital workflows)
APPOINTMENT_REASSIGNMENT_WINDOW_DAYS=7
APPOINTMENT_FULLY_BOOKED_WINDOW_DAYS=7
APPOINTMENT_REQUIRES_APPROVAL=true

# Session and report security
INACTIVITY_ENABLED=true
REPORT_PASSWORD_CONFIRM_MINUTES=5

# Privacy and consent versions. Replace versions and contact placeholders before production.
PRIVACY_NOTICE_VERSION=1.0
TERMS_VERSION=1.0
PRIVACY_EFFECTIVE_DATE=2026-10-13
AI_SEND_AGE_SEX=true
# REQUIRED IN PRODUCTION: set the hospital's real DPO contact details in deployment secrets/configuration.
DPO_NAME=
DPO_EMAIL=
DPO_PHONE=

# Optional mail providers. Configure only the provider used by MAIL_MAILER.
POSTMARK_API_KEY=
RESEND_API_KEY=

# Optional Slack notifications
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Zapier (workflow automation - never the primary database)
ZAPIER_ENABLED=false
ZAPIER_WEBHOOK_URL=
